#!/command/with-contenv sh
# shellcheck shell=sh
# 00-atlas-seed — Atlas-deploy volume seeding for the s6-overlay image.
#
# Replaces the parts of the retired tini-era docker/entrypoint.sh that
# upstream's stage2 hook does NOT cover. Everything else moved upstream:
#   - volume chown / UID remap / dir structure  → 01-hermes-setup (stage2-hook.sh)
#   - .env seed, SOUL.md write-once seed        → 01 seed_one() (reads our baked
#     /opt/hermes/docker/SOUL.md, so the Atlas persona slots in unchanged)
#   - auth.json bootstrap from HERMES_AUTH_JSON_BOOTSTRAP → 01
#   - config schema migration                   → 01 (docker_config_migrate.py)
#   - skills sync                               → 01
#   - dashboard side-process                    → s6 `dashboard` service
#     (same HERMES_DASHBOARD env gate as before)
#
# The 00- prefix is load-bearing: cont-init.d runs lexicographically, so we
# run BEFORE 01-hermes-setup. That ordering means:
#   - 01's write-once config.yaml seed sees our copy and skips its
#     cli-config.yaml.example fallback, and
#   - 01's docker_config_migrate.py migrates our freshly-copied
#     atlas-config.yaml, so the gateway always reads a current-schema config
#     (the seed file is maintained at the schema it was written for).
#
# We run as root (cont-init context). 01 chowns cron/ recursively and
# config.yaml explicitly on every boot, but NOT memories content or our
# google-workspace-mcp dir on an already-owned volume — so we chown what
# we write ourselves.

set -eu

HERMES_HOME="${HERMES_HOME:-/opt/data}"
INSTALL_DIR="/opt/hermes"

mkdir -p "$HERMES_HOME/memories" "$HERMES_HOME/cron"

# config.yaml — seed is authoritative on every boot (IaC: edit
# atlas-config.yaml, push, redeploy). In-container edits are erased.
cp "$INSTALL_DIR/docker/atlas-config.yaml" "$HERMES_HOME/config.yaml"
chown hermes:hermes "$HERMES_HOME/config.yaml" 2>/dev/null || true
chmod 640 "$HERMES_HOME/config.yaml" 2>/dev/null || true

# Atlas seed memories — write-once so Hermes' runtime memory appends are
# preserved across deploys. HERMES_FORCE_RESEED_MEMORIES=1 (one deploy)
# replaces the volume copies with the seed.
if [ -d "$INSTALL_DIR/docker/seed-memories" ]; then
    for f in "$INSTALL_DIR/docker/seed-memories"/*.md; do
        [ -e "$f" ] || continue
        name=$(basename "$f")
        if [ ! -f "$HERMES_HOME/memories/$name" ] \
           || [ "${HERMES_FORCE_RESEED_MEMORIES:-0}" = "1" ]; then
            cp "$f" "$HERMES_HOME/memories/$name"
            chown hermes:hermes "$HERMES_HOME/memories/$name" 2>/dev/null || true
        fi
    done
fi

# Atlas seed cron jobs — declarative merge on every boot. Seed owns each
# job's declarative shape (prompt, schedule, enabled, deliver, ...); the
# volume owns runtime state (last_run_at, next_run_at, ...). Jobs created
# at runtime (Atlas via Slack) are preserved. HERMES_FORCE_RESEED_CRON=1
# discards runtime state and user-added jobs.
if [ -d "$INSTALL_DIR/docker/seed-cron" ]; then
    for seed_file in "$INSTALL_DIR/docker/seed-cron"/*.json; do
        [ -e "$seed_file" ] || continue
        name=$(basename "$seed_file")
        vol_file="$HERMES_HOME/cron/$name"
        if [ ! -f "$vol_file" ] || [ "${HERMES_FORCE_RESEED_CRON:-0}" = "1" ]; then
            cp "$seed_file" "$vol_file"
        else
            "$INSTALL_DIR/.venv/bin/python" \
                "$INSTALL_DIR/docker/merge_cron_seed.py" "$seed_file" "$vol_file"
        fi
        chown hermes:hermes "$vol_file" 2>/dev/null || true
    done
fi

# Google Workspace MCP credentials — seed per-account refresh tokens from
# Railway env on first boot (write-once; GOOGLE_CREDS_RESEED=1 to force).
gws_seed() {
    label="$1"; email="$2"; b64="$3"
    [ -n "$b64" ] || return 0
    dir="$HERMES_HOME/google-workspace-mcp/${label}-creds"
    file="$dir/${email}.json"
    mkdir -p "$dir"
    chmod 700 "$dir"
    if [ ! -f "$file" ] || [ "${GOOGLE_CREDS_RESEED:-0}" = "1" ]; then
        echo "[atlas-seed] Seeding google-workspace-mcp creds: $file"
        printf '%s' "$b64" | base64 -d > "$file"
        chmod 600 "$file"
    fi
    chown -R hermes:hermes "$HERMES_HOME/google-workspace-mcp" 2>/dev/null || true
}
gws_seed personal "quiksilvere@gmail.com" "${GOOGLE_CREDS_PERSONAL_B64:-}"
gws_seed work     "hello@pksprops.com"    "${GOOGLE_CREDS_WORK_B64:-}"

# Keep the s6 profile reconciler's gateway slot DOWN. On this deploy the
# gateway runs as the container CMD (main-wrapper → `hermes gateway run -v`),
# NOT as a supervised per-profile service. If a previous run recorded
# gateway_state=running, 02-reconcile-profiles would auto-start a SECOND
# gateway alongside the CMD one → double Slack responses. Reset before 02
# runs (lexicographic ordering guarantees that).
printf '{"gateway_state":"stopped"}\n' > "$HERMES_HOME/gateway_state.json"
chown hermes:hermes "$HERMES_HOME/gateway_state.json" 2>/dev/null || true
chmod 644 "$HERMES_HOME/gateway_state.json" 2>/dev/null || true

echo "[atlas-seed] Atlas volume seeding complete"
